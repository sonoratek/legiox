  "threat_assessment_framework": {
    "threat_dimensions": {
      "market_overlap": {
        "high": "Direct competitor targeting same segments",
        "medium": "Adjacent player with expansion potential",
        "low": "Distant player or different market"
      },
      "resource_advantage": {
        "high": "Significantly better funded or resourced",
        "medium": "Similar resource position",
        "low": "Resource-constrained or startup"
      },
      "technology_advantage": {
        "high": "Superior technology or major breakthrough",
        "medium": "Feature parity or minor advantages",
        "low": "Technology disadvantage"
      },
      "market_traction": {
        "high": "Strong customer base and growth",
        "medium": "Growing but not dominant",
        "low": "Early stage or struggling"
      },
      "strategic_intent": {
        "high": "Clearly targeting our core market",
        "medium": "Possible expansion into our space",
        "low": "Focused elsewhere"
      }
    },
    "composite_threat_score": {
      "calculation": "Weighted average of dimensions",
      "weights": {
        "market_overlap": 0.3,
        "resource_advantage": 0.2,
        "technology_advantage": 0.25,
        "market_traction": 0.15,
        "strategic_intent": 0.1
      },
      "thresholds": {
        "critical": "85-100 (immediate action required)",
        "high": "70-84 (active monitoring and response)",
        "medium": "50-69 (regular monitoring)",
        "low": "0-49 (periodic check-ins)"
      }
    }
  },
