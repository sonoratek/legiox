  "attack_vectors_monitored": {
    "dependency_attacks": [
      {
        "attack": "dependency_confusion",
        "description": "Malicious public package with same name as private package",
        "mitigation": "Private registry prioritization, namespace protection"
      },
      {
        "attack": "typosquatting",
        "description": "Malicious package with similar name to popular package",
        "mitigation": "Package name similarity detection, verification prompts"
      },
      {
        "attack": "malicious_maintainer",
        "description": "Legitimate package compromised by new maintainer",
        "mitigation": "Maintainer change alerts, code diff analysis"
      },
      {
        "attack": "compromised_account",
        "description": "Attacker gains access to maintainer account",
        "mitigation": "Package signature verification, behavioral analysis"
      }
    ],
    "build_pipeline_attacks": [
      {
        "attack": "ci_cd_compromise",
        "description": "Attacker modifies build pipeline to inject malicious code",
        "mitigation": "Pipeline as code, access controls, audit logs"
      },
      {
        "attack": "build_environment_tampering",
        "description": "Malicious code injected during build process",
        "mitigation": "Hermetic builds, reproducible builds, provenance attestation"
      },
      {
        "attack": "artifact_substitution",
        "description": "Built artifacts replaced with malicious versions",
        "mitigation": "Artifact signing, checksum verification, provenance chain"
      }
    ]
  },
