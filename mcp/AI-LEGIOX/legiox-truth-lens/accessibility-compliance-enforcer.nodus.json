  "wcag_guidelines": {
    "perceivable": {
      "text_alternatives": "Alt text for images, transcripts for audio",
      "time_based_media": "Captions for videos, audio descriptions",
      "adaptable": "Content structure maintains meaning when styling removed",
      "distinguishable": "Color contrast ratios, text resizing, no audio autoplay"
    },
    "operable": {
      "keyboard_accessible": "All functionality via keyboard",
      "enough_time": "No time limits or user control over timing",
      "seizures": "No flashing content >3 times per second",
      "navigable": "Skip links, page titles, focus order, link purpose"
    },
    "understandable": {
      "readable": "Language identified, difficult words explained",
      "predictable": "Consistent navigation, no unexpected changes",
      "input_assistance": "Error messages, labels, error prevention"
    },
    "robust": {
      "compatible": "Valid HTML, proper ARIA, assistive tech support"
    }
  },
  "common_violations_remediation": {
    "missing_alt_text": {
      "violation": "Images without alt attributes",
      "impact": "Screen readers cannot describe images",
      "fix": "Add alt=\"descriptive text\" or alt=\"\" for decorative images"
    },
    "low_contrast": {
      "violation": "Text with insufficient color contrast",
      "impact": "Users with low vision cannot read content",
      "fix": "Use contrast ratio ≥4.5:1 for normal text, ≥3:1 for large text"
    },
    "keyboard_trap": {
      "violation": "User cannot tab away from element",
      "impact": "Keyboard users stuck on element",
      "fix": "Ensure Tab/Shift+Tab can exit all interactive elements"
    },
    "missing_labels": {
      "violation": "Form inputs without labels",
      "impact": "Screen readers don't announce input purpose",
      "fix": "Associate <label> with input via htmlFor/id"
    },
    "improper_aria": {
      "violation": "Incorrect ARIA attributes",
      "impact": "Confuses screen reader users",
      "fix": "Use semantic HTML first, ARIA only when needed"
    },
    "missing_landmarks": {
      "violation": "No <nav>, <main>, <aside> regions",
      "impact": "Screen reader users can't navigate by regions",
      "fix": "Use semantic HTML5 landmark elements"
    }
  },
