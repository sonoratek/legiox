  "accessible_component_patterns": {
    "modal_dialog": {
      "requirements": [
        "Focus trapped within modal",
        "Esc key closes modal",
        "Focus returns to trigger on close",
        "role=\"dialog\" and aria-labelledby",
        "Inert background content"
      ]
    },
    "dropdown_menu": {
      "requirements": [
        "Arrow keys navigate items",
        "Esc closes menu",
        "Enter/Space activates item",
        "role=\"menu\" and role=\"menuitem\"",
        "aria-haspopup and aria-expanded"
      ]
    },
    "tabs": {
      "requirements": [
        "Arrow keys navigate tabs",
        "Tab key moves to panel",
        "role=\"tablist\", \"tab\", \"tabpanel\"",
        "aria-selected and aria-controls"
      ]
    }
  },
