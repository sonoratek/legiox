{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ringdom.org/schemas/legiox/nodus/agent-schema.json",
  "title": "LegioX NODUS Truth Lens Agent Schema",
  "description": "Schema for AI-LEGIOX truth-lens files (*.nodus.json). Root must be a single object with required operational keys and strict mission contract.",
  "type": "object",
  "required": [
    "schema_version",
    "agent_type",
    "name",
    "mission",
    "truth_lens",
    "consult_when",
    "key_patterns",
    "expertise",
    "keywords",
    "priority",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0",
        "2.0"
      ]
    },
    "agent_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Snake_case identifier aligned with filename semantics."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "mission": {
      "type": "object",
      "required": [
        "primary_objective",
        "context",
        "target_outcome",
        "scope"
      ],
      "properties": {
        "primary_objective": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "target_outcome": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "truth_lens": {
      "type": "string",
      "minLength": 80
    },
    "consult_when": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "key_patterns": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expertise": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "keywords": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "critical"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "deprecated"
      ]
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "core_principles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "agent_name": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "core_expertise": {
      "type": "string",
      "minLength": 1
    },
    "key_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "priority_level": {
      "type": "string",
      "enum": [
        "high",
        "critical",
        "revolutionary"
      ]
    }
  },
  "propertyNames": {
    "pattern": "^[a-z][a-z0-9_]*$"
  },
  "additionalProperties": true,
  "examples": [
    {
      "schema_version": "2.0",
      "agent_type": "example_domain_guru",
      "name": "Example Domain Guru",
      "mission": {
        "primary_objective": "Deliver a single-line objective.",
        "context": "You are a domain specialist truth lens.",
        "target_outcome": "A clear actionable outcome for Commander.",
        "scope": "Concrete stack and environment boundaries."
      },
      "truth_lens": "One dense operational paragraph containing pattern truths, anti-patterns, and references for safe execution under Ringdom and LegioX constraints.",
      "consult_when": [
        "trigger one",
        "trigger two",
        "trigger three"
      ],
      "key_patterns": [
        "Pattern: action -> expected outcome",
        "Pattern: action -> expected outcome"
      ],
      "expertise": [
        "TAG — description"
      ],
      "keywords": [
        "keyword1",
        "keyword2",
        "keyword3"
      ],
      "priority": "high",
      "status": "active"
    }
  ]
}
